# Copy to .env (gitignored) next to docker-compose.yml.
# Host path of the recordings share (mounted read-only):
SETHSTER_MEDIA_DIR=/volume1/your-music-share
# off | dormant | on
SETHSTER_ACCOUNTS=on
TZ=America/New_York
# Optional, for push notifications:
APNS_KEY_ID=
# Contact address shown on /privacy:
SETHSTER_CONTACT_EMAIL=you@example.com
